@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF0F8
  BorderColor #1A237E
  DiamondBackgroundColor #FDF3D0
  DiamondBorderColor #8A6D00
}
|Сотрудники клуба|
start
:Регистрация нового клиента
(ФИО, телефон, почта, дата рождения);
|Информационная система|
:Проверка введённых данных;
:Выпуск номера клиентской карты
и учётной записи с ролью «Клиент»;
|Сотрудники клуба|
:Оформление абонемента
(клиент, тип, способ оплаты);
|Информационная система|
:Расчёт даты окончания
по длительности типа;
:Фиксация платежа и чека (транзакция);
|Тренер|
:Формирование расписания занятий
(тип, зал, время, лимит мест);
|Информационная система|
if (Пересечение по залу\nили тренеру?) then (да)
  :Отказ в сохранении\nс описанием конфликта;
  detach
else (нет)
  :Сохранение занятия в расписании;
endif
|Клиент|
:Запись на занятие
из расписания;
|Информационная система|
if (Абонемент действующий\nи есть свободные места?) then (нет)
  :Отказ с указанием причины;
  detach
else (да)
  :Создание записи посещения
  со статусом «Записан»;
endif
|Тренер|
:Проведение занятия,\nотметка пришедших клиентов;
|Информационная система|
:Сохранение отметок\nв истории посещений;
|Администратор|
:Контроль прохода через турникет\nпо номеру клиентской карты;
|Информационная система|
if (Действующий абонемент?) then (да)
  :Проход разрешён,\nпосещение зарегистрировано;
else (нет)
  :Проход запрещён,\nуведомление администратору;
endif
|Бухгалтерия|
:Формирование финансового отчёта;
|Информационная система|
:Сводка поступлений,\nразбивка по способам оплаты\nи типам абонементов;
stop
@enduml
